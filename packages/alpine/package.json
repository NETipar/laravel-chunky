{
    "name": "@netipar/chunky-alpine",
    "version": "1.0.0",
    "description": "Alpine.js data component for Laravel Chunky chunk uploads",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc --noEmit -p tsconfig.json && tsup"
    },
    "keywords": [
        "chunky",
        "upload",
        "chunk",
        "file-upload",
        "laravel",
        "alpine",
        "alpinejs",
        "livewire"
    ],
    "license": "MIT",
    "homepage": "https://github.com/NETipar/laravel-chunky",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NETipar/laravel-chunky.git",
        "directory": "packages/alpine"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@netipar/chunky-core": "workspace:^"
    },
    "sideEffects": false
}
