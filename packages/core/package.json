{
    "name": "@netipar/chunky-core",
    "version": "0.22.6",
    "description": "Framework-agnostic chunk upload engine for Laravel Chunky",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./tools": {
            "import": {
                "types": "./dist/tools.d.ts",
                "default": "./dist/tools.js"
            },
            "require": {
                "types": "./dist/tools.d.cts",
                "default": "./dist/tools.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc --noEmit -p tsconfig.json && tsup"
    },
    "keywords": [
        "chunky",
        "upload",
        "chunk",
        "file-upload",
        "laravel"
    ],
    "license": "MIT",
    "homepage": "https://github.com/NETipar/laravel-chunky",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NETipar/laravel-chunky.git",
        "directory": "packages/core"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false
}
