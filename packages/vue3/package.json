{
    "name": "@netipar/chunky-vue3",
    "version": "1.0.0-beta.1",
    "description": "Vue 3 composables and components for Laravel Chunky chunk uploads",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc --noEmit -p tsconfig.json && tsup"
    },
    "keywords": [
        "chunky",
        "upload",
        "chunk",
        "file-upload",
        "laravel",
        "vue",
        "vue3",
        "composable"
    ],
    "license": "MIT",
    "homepage": "https://github.com/NETipar/laravel-chunky",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/NETipar/laravel-chunky.git",
        "directory": "packages/vue3"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@netipar/chunky-core": "workspace:^"
    },
    "peerDependencies": {
        "vue": "^3.5"
    },
    "devDependencies": {
        "vue": "^3.5"
    },
    "sideEffects": false
}
